{
  "mcpServers": {
    "spritecook": {
      "type": "http",
      "url": "https://mcp.spritecook.ai/mcp/cursor"
    },
    "summer-engine": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "summer-engine@latest",
        "mcp",
        "--project",
        "${workspaceFolder}"
      ]
    }
  }
}
