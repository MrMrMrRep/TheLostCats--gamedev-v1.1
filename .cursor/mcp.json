{
  "mcpServers": {
    "spritecook": {
      "url": "https://api.spritecook.ai/mcp/",
      "headers": {
        "Authorization": "Bearer ${env:SPRITECOOK_API_KEY}"
      }
    },
    "summer-engine": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "summer-engine@latest",
        "mcp",
        "--project",
        "${workspaceFolder}"
      ]
    }
  }
}
