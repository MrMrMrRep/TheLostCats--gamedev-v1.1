class_name PixelFont
extends RefCounted
## A chunky 5x7 pixel font for world-map signs (gantries, road signs, the
## viaduct), the same letters as the style v3 mocks' sign lettering.
## draw_string() takes the same arguments as CanvasItem.draw_string, so a
## call to the default font swaps over directly. Capitals only (lower case
## is drawn as capitals), digits and a little punctuation.

const GLYPHS := {
	"A": "01110100011000111111100011000110001", "B": "11110100011000111110100011000111110",
	"C": "01110100011000010000100001000101110", "D": "11110100011000110001100011000111110",
	"E": "11111100001000011110100001000011111", "F": "11111100001000011110100001000010000",
	"G": "01110100011000010111100011000101111", "H": "10001100011000111111100011000110001",
	"I": "01110001000010000100001000010001110", "J": "00111000100001000010000101001001100",
	"K": "10001100101010011000101001001010001", "L": "10000100001000010000100001000011111",
	"M": "10001110111010110101100011000110001", "N": "10001110011010110011100011000110001",
	"O": "01110100011000110001100011000101110", "P": "11110100011000111110100001000010000",
	"Q": "01110100011000110001101011001001101", "R": "11110100011000111110101001001010001",
	"S": "01111100001000001110000010000111110", "T": "11111001000010000100001000010000100",
	"U": "10001100011000110001100011000101110", "V": "10001100011000110001100010101000100",
	"W": "10001100011000110101101011010101010", "X": "10001100010101000100010101000110001",
	"Y": "10001100010101000100001000010000100", "Z": "11111000010001000100010001000011111",
	"0": "01110100011001110101110011000101110", "1": "00100011000010000100001000010001110",
	"2": "01110100010000100010001000100011111", "3": "11110000010000101110000010000111110",
	"4": "00010001100101010010111110001000010", "5": "11111100001111000001000011000101110",
	"6": "00110010001000011110100011000101110", "7": "11111000010001000100010000100001000",
	"8": "01110100011000101110100011000101110", "9": "01110100011000101111000010001001100",
	"-": "00000000000000011111000000000000000", ".": "00000000000000000000000000110001100",
	"'": "00100001000100000000000000000000000", ">": "10000010000010000010001000100010000",
	"<": "00001000100010001000001000001000001", ":": "00000011000110000000011000110000000",
	"/": "00001000010001000100010001000010000", "&": "01100100101010001000101011001001101",
	" ": "00000000000000000000000000000000000",
}


## Pixel size for a font size given to draw_string (8 and up: 1 px per dot).
static func dot(font_size: int) -> float:
	return 1.0 if font_size >= 7 else 0.5


## Width of `text` in the node's px.
static func width(text: String, font_size := 8) -> float:
	return maxf(text.length() * 6.0 - 1.0, 0.0) * dot(font_size)


## Like CanvasItem.draw_string: `pos` is the left end of the baseline;
## `align`/`max_width` centre or right-align inside max_width.
static func draw_string(ci: CanvasItem, pos: Vector2, text: String, align := HORIZONTAL_ALIGNMENT_LEFT,
		max_width := -1.0, font_size := 8, color := Color.WHITE) -> void:
	var d := dot(font_size)
	var s := text.to_upper()
	var w := width(s, font_size)
	var x := pos.x
	if max_width > 0.0:
		if align == HORIZONTAL_ALIGNMENT_CENTER:
			x += floorf((max_width - w) / 2.0)
		elif align == HORIZONTAL_ALIGNMENT_RIGHT:
			x += max_width - w
	var top := pos.y - 7.0 * d
	for i in s.length():
		var g: String = GLYPHS.get(s[i], GLYPHS[" "])
		for k in 35:
			if g[k] == "1":
				ci.draw_rect(Rect2(x + (i * 6 + k % 5) * d, top + (k / 5) * d, d, d), color)
