func _turbine(x: int, base: int, h: int) -> void:
	for yy in h:
		var w := 2 + (h - yy) * 3 / h
		_rect(x - w / 2, base - yy, w, 1, T7)
		_px(x + w / 2, base - yy, T6)
	var hub := Vector2(x, base - h)
	_rect(x - 3, base - h - 3, 9, 5, T7)
	_rect(x - 3, base - h + 1, 9, 1, T6)
	var turn := float(x) * 0.7
	for a in [0.0, 120.0, 240.0]:
		var d := Vector2(cos(deg_to_rad(a + turn)), sin(deg_to_rad(a + turn)))
		var n := Vector2(-d.y, d.x)
		for k in range(3, int(h * 0.48)):
			var p := hub + d * k
			var wid := 2.0 if k < h * 0.2 else 1.0
			_px(int(p.x), int(p.y), T7)
			if wid > 1.0:
				var q := p + n
				_px(int(q.x), int(q.y), T6)
	WDisc.draw(self, x, base - h, 2, W5)


func _birds(x: int, y: int) -> void:
	for b in [[0, 0], [14, 6], [-12, 8], [26, 12], [-22, 14]]:
		var bx: int = x + b[0]
		var by: int = y + b[1]
		_px(bx - 2, by - 1, T1)
		_px(bx - 1, by, T1)
		_px(bx, by + 1, T1)
		_px(bx + 1, by, T1)
		_px(bx + 2, by - 1, T1)


func _poplar(x: int, base: int, h: int) -> void:
	_rect(x, base - 12, 2, 12, W0)
	for yy in h:
		var t := float(yy) / h
		var half := int(7.0 * sin(t * PI) * (1.0 - t * 0.3)) + 1
		for xx in range(-half, half + 1):
			var l := -float(xx) / half * 0.6 + (_hash(x + xx, yy / 2) - 0.5) * 0.8
			_px(x + xx, base - 10 - yy, G1 if l < -0.2 else (G2 if l < 0.35 else G3))
	_rect(x + 1, base - 12, 1, 12, W1)


func _tree_small(x: int, base: int, s: float) -> void:
