	_sun(240, 120, 26)
	_streaks()
	_cloud(560, 110, 2.3)
	_cloud(1100, 160, 1.6)
	_skyline_far()
	_skyline_mid()
	# Park: big trees behind a hedge and an iron fence, with a bandstand.
	for t in [[40, 1.1], [200, 0.95], [360, 1.15], [560, 1.0]]:
		_park_tree(int(t[0]), float(t[1]))
	_bandstand(300)
	_hedge(0, 660, GY - 40)
	_park_fence(0, 660)
	_park_gate(470)
	_theatre(680, 420)
	_house({"x": 1100, "w": 140, "f": 3, "s": "cream", "g": "mansard", "gr": "shop", "shop": "cafe", "sign": "PARKCAFE", "awn": [G1, W4], "fascia": G0, "quoins": true})
	_house({"x": 1240, "w": 120, "f": 4, "s": "brick", "g": "bell", "gr": "door", "boxes": true, "no": "8"})
	_house({"x": 1360, "w": 112, "f": 4, "s": "teal", "g": "spout", "gr": "door", "plaque": true, "no": "10"})
	_street()
	_quay()
	_reflect()
	_terrace(1110)
	_aboard(1222, "CA")
	for bx in [90, 250, 420]:
		_bench(bx)
	_lamp(150)
	_lamp(640)
	_lamp(1090)
	_poster_column(1050)
	_bike(560, G1, true)
	_tree(20, 0.9)
	_houseboat(900)


func _park_tree(x: int, s: float) -> void:
	# A big park tree behind the hedge: _tree, but standing on the park lawn.
	_tree(x, s)


func _park_fence(x: int, w: int) -> void:
	# Low spear-top iron fence on a stone curb.
	_rect(x, GY - 6, w, 6, R2)
	_rect(x, GY - 6, w, 1, R3)
	_rect(x, GY - 1, w, 1, R1)
	_rect(x, GY - 34, w, 2, T0)
	_rect(x, GY - 14, w, 2, T0)
	for k in range(x + 2, x + w, 6):
		_rect(k, GY - 40, 2, 34, T0)
		_px(k, GY - 41, T0)
		_px(k + 1, GY - 42, T1)
	for k in range(x + 50, x + w, 100):
		_bevel(k, GY - 50, 8, 44, R2, R3, R1)
		_rect(k - 2, GY - 54, 12, 4, R3)
		WDisc.draw(self, k + 4, GY - 58, 4, R2)


func _park_gate(x: int) -> void:
	# Two brick gate piers with lanterns and a name arch.
	for px_ in [x, x + 92]:
		for yy in range(GY - 96, GY):
			for xx in range(px_, px_ + 18):
				var c := B2 if ((xx + (yy / 4 % 2) * 4) % 8 != 0 and yy % 4 != 3) else B1
				_px(xx, yy, c)
		_rect(px_, GY - 96, 2, 96, B3)
		_rect(px_ + 16, GY - 96, 2, 96, B0)
		_bevel(px_ - 3, GY - 102, 24, 6, W3, W5, W2)
		_lantern(px_ + 6, GY - 118)
	_rect(x + 18, GY - 96, 74, 96, G0)                  # path through the gate
	for yy in range(GY - 30, GY):
		_rect(x + 18, yy, 74, 1, W2 if yy % 3 else W1)
	_rect(x + 18, GY - 90, 74, 12, T0)
	_rect(x + 19, GY - 89, 72, 10, T2)
	_text5(x + 32, GY - 87, "PARK", W5)
	for k in range(x + 20, x + 90, 6):                 # open gates
		_rect(k, GY - 60, 1, 54, T0)
	_rect(x + 18, GY - 60, 16, 2, T0)
	_rect(x + 76, GY - 60, 16, 2, T0)


func _bandstand(x: int) -> void:
	# The muziektent: octagonal iron bandstand on a brick base. A stage for the band later.
	var b := GY - 30
	for yy in range(b - 14, b + 30):                   # base (half hidden by the hedge)
		for xx in range(x - 80, x + 80):
			var c := B2 if ((xx + (yy / 4 % 2) * 4) % 8 != 0 and yy % 4 != 3) else B1
			_px(xx, yy, c)
	_rect(x - 84, b - 18, 168, 5, W4)
	_rect(x - 84, b - 18, 168, 1, W5)
	_rect(x - 84, b - 13, 168, 1, T0)
	# Columns + lattice railing.
	for cx in [x - 76, x - 44, x - 14, x + 14, x + 44, x + 74]:
		_rect(cx, b - 108, 3, 90, G0)
		_px(cx, b - 108, G1)
		_rect(cx - 2, b - 108, 7, 3, G0)
	_rect(x - 80, b - 40, 160, 2, G0)
	for k in range(x - 78, x + 78, 6):
		_line(k, b - 38, k + 5, b - 20, G0)
		_line(k + 5, b - 38, k, b - 20, G0)
	_rect(x - 80, b - 20, 160, 2, G0)
	# Musicians' stands (empty, waiting for a band).
	for mx in [x - 30, x + 24]:
		_rect(mx, b - 52, 1, 34, T0)
		_rect(mx - 6, b - 56, 12, 6, T0)
		_rect(mx - 5, b - 55, 10, 4, W5)
	# Roof: an ogee dome in green with a cream fringe.
	_rect(x - 92, b - 116, 184, 8, W4)
	for k in range(x - 92, x + 92, 6):
		_triangle(k, b - 106, 6, -1, W4)
		_rect(k + 1, b - 108, 4, 3, W4)
		_px(k + 2, b - 105, W3)
	_rect(x - 92, b - 116, 184, 1, W5)
	_rect(x - 92, b - 109, 184, 1, W2)
	for yy in 52:
		var t := yy / 52.0
		var half := int(92.0 * (1.0 - t) * (0.7 + 0.3 * cos(t * PI * 1.2)))
		half = maxi(half, 4)
		for xx in range(-half, half):
			var u := float(xx + half) / (half * 2)
			var c := G1
			if u < 0.25:
				c = G2
			elif u > 0.78:
				c = G0
			if (x + xx) % 12 == 0:
				c = G0 if c != G0 else T0
			_px(x + xx, b - 117 - yy, c)
		_px(x - half - 1, b - 117 - yy, T0)
		_px(x + half, b - 117 - yy, T0)
	_rect(x - 1, b - 184, 3, 16, G0)
	WDisc.draw(self, x, b - 186, 4, O2)
	_px(x - 1, b - 188, O3)


func _theatre(x: int, w: int) -> void:
	# The Stadsschouwburg-like theatre: stone portico, posters, gig marquee.
	_scheme("cream")
	var top := GY - 330
	_wall(x, top, w, GY - top)
	_outline_lit(x, top, w)
	# Upper windows: tall arched.
	for i in 6:
		var wx := x + 22 + i * (w - 44) / 6 + 8
		_window(wx, top + 70, 26, 56, false, true)
	_course(x, top + 140, w)
	_cornice(x, top, w)
	# Attic with the name + pediment.
	_rect(x + 40, top - 46, w - 80, 32, W3)
	_rect(x + 40, top - 46, w - 80, 1, W5)
	_rect(x + 40, top - 46, 1, 32, W5)
