func _motorway(top: int, bottom: int) -> void:
	for y in range(top, bottom):
		for x in range(OX, OX + W):
			var c := R0
			var n := _hash(x, y)
			if n < 0.12:
				c = R1
			elif n > 0.95:
				c = T0
			_put_px(x, y, c)
	_rect(OX, top, W, 2, R2)
	_rect(OX, top + 3, W, 2, W5)                     # edge line
	_rect(OX, bottom - 5, W, 2, W5)
	var mid := (top + bottom) / 2
	for x in range(OX - posmod(OX, 60), OX + W, 60):                       # lane dashes
		_rect(x, mid, 30, 2, W5)
		_rect(x, mid + 2, 30, 1, R1)
	_rect(OX, bottom - 2, W, 2, R1)


