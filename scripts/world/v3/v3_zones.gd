func _shop_window(x: int, y: int, w: int, h: int, shop: String) -> void:
	if shop != "kaas":
		super(x, y, w, h, shop)
		return
	# Cheese shop: shelves of wheels (cut ones show the yellow inside).
	_rect(x, y, w, h, W1)
	_rect(x, y, w, 3, W0)
	for sy in [y + h / 3, y + h * 2 / 3, y + h - 3]:
		_rect(x, sy, w, 2, W0)
		for lx in range(x + 2, x + w - 12, 13):
			var cut := _hash(lx, sy) < 0.35
			_rect(lx, sy - 9, 12, 9, O2)
			_rect(lx, sy - 9, 12, 2, O3)
			_rect(lx, sy - 2, 12, 2, O1)
			_rect(lx + 11, sy - 9, 1, 9, O1)
			if cut:
				_triangle(lx + 4, sy - 2, 8, 7, G4)
			if _hash(sy, lx) < 0.3:
				_rect(lx, sy - 9, 12, 9, B2)            # red wax edam
				_rect(lx, sy - 9, 12, 2, B3)
	_rect(x, y, w, 2, T0)
	for i in h:
		var gx := x + 6 + (h - i) * 3 / 4
		for k in 5:
			if gx + k < x + w - 1 and (i + k) % 9 != 0:
				_px(gx + k, y + i, W2 if k < 2 else W3)
	_rect(x + w / 3, y, 1, h, T0)


