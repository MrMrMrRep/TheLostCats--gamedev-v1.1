func _reeds_big(x: int) -> void:
	for i in 14:
		var rx := x + i * 3 + int(_hash(x, i) * 3.0)
		var h := 34 + int(_hash(i, x) * 40.0)
		var lean := (i - 7) * 0.2
		for k in h:
			var px_ := rx + int(lean * k * k / float(h))
			_rect(px_, H - 1 - k, 2 if k < h * 2 / 3 else 1, 1, G1 if i % 2 else (G2 if k > 8 else G0))
