func _ring_block(x: int, w: int, floors: int, scheme: String, balconies: bool, shop: String) -> void:
	# A wide 1890s block (ring style): flat cornice, 4-5 bays, iron balconies,
	# a portiek door with a stair, basement windows.
	_scheme(scheme)
	plot_l = x
	plot_r = x + w
	var top := GY - GF - ST * (floors - 1)
	_wall(x, top, w, GY - top)
	_outline_lit(x, top, w)
	_cornice(x, top, w)
	var bays := maxi(w / 48, 3)
	var bay := w / bays
	for f in range(1, floors):
		var fy := GY - GF - ST * f
		_course(x, fy + ST - 8, w)
		for b in bays:
			var wx := x + b * bay + (bay - 24) / 2
			_window(wx, fy + 10, 24, 40, false, f == floors - 1 and b % 2 == 1)
		if balconies and f <= 2:
			var bx := x + bay - 8
			var bw := bay * (bays - 2) + 16
			_rect(bx, fy + ST - 16, bw, 4, R2)
			_rect(bx, fy + ST - 16, bw, 1, R3)
			_rect(bx, fy + ST - 12, bw, 1, T0)
			_rect(bx, fy + ST - 36, bw, 2, T0)
			for k in range(bx, bx + bw, 4):
				_rect(k, fy + ST - 34, 1, 18, T0)
				if k % 12 == 0:
					WDisc.ring(self, k + 2, fy + ST - 25, 2, T0)
			if _hash(x, f) < 0.7:                       # pots + a chair
				for k in 3:
					var pxx := bx + 6 + int(_hash(x + k, f) * (bw - 20))
					_rect(pxx, fy + ST - 22, 6, 6, B2)
					_rect(pxx, fy + ST - 22, 6, 1, B3)
					_leaves(pxx + 3, fy + ST - 26, 4)
	# Ground floor.
	_plinth(x, w)
	if shop != "":
		_shop_front(x + 4, w - 8, {"sign": shop, "shop": "bakker", "fascia": T1, "awn": [T2, W5]})
		_seal(x, w)
		plot_l = -1000000
		plot_r = 1000000
		return
	# Portiek: a deep doorway with steps and three bells.
	var dx := x + 10
	_rect(dx - 2, GY - 78, 42, 78, T0)
	_rect(dx, GY - 76, 38, 64, cs)
	var dc: Color = [G1, T1, B1][int(_hash(x, 2) * 3.0)]
	_rect(dx + 4, GY - 72, 30, 60, dc)
	_rect(dx + 4, GY - 72, 1, 60, W5 if dc != T1 else T2)
	_rect(dx + 8, GY - 68, 22, 22, T0)
	_rect(dx + 9, GY - 67, 20, 20, T2)
	for k in 8:
		_px(dx + 11 + k, GY - 49 - k * 2, T4)
	_rect(dx + 26, GY - 40, 3, 3, O2)
	for k in 3:
		_rect(dx + 36, GY - 60 + k * 6, 3, 3, R3)
	for i in 3:
		_rect(dx - 2 - i * 3, GY - 12 + i * 4, 42 + i * 6, 4, R2)
		_rect(dx - 2 - i * 3, GY - 12 + i * 4, 42 + i * 6, 1, R3)
	for b in range(1, bays):
		var wx := x + b * bay + (bay - 24) / 2
		_window(wx, GY - GF + 14, 24, 44, b % 2 == 0, false)
		_rect(wx - 2, GY - 22, 28, 12, T0)               # basement grille
		for k in range(wx, wx + 24, 4):
			_rect(k, GY - 21, 1, 10, R1)
	_seal(x, w)
	plot_l = -1000000
	plot_r = 1000000


func _new_block(x: int, w: int) -> void:
	# A 2010s apartment block: brick plinth, wood-clad upper floors, glass balconies.
	plot_l = x
	plot_r = x + w
	var floors := 6
	var fh := 62
	var top := GY - floors * fh - 20
	# Brick plinth floor.
	for yy in range(GY - fh - 20, GY):
		for xx in range(x, x + w):
			var c := W1 if ((xx + (yy / 4 % 2) * 5) % 10 != 0 and yy % 4 != 3) else W0
			_px(xx, yy, c)
	# Wood cladding above.
	for yy in range(top, GY - fh - 20):
		for xx in range(x, x + w):
			var k := (xx - x) % 6
			var c := W2
			if k == 0:
				c = W1
			elif k == 1:
				c = W3
			if _hash(xx / 6, yy / 40) < 0.15 and k > 1:
				c = W3
			_px(xx, yy, c)
	_rect(x, top - 6, w, 6, R3)
	_rect(x, top - 6, w, 1, W5)
	_rect(x, top, w, 1, T0)
	_rect(x, top, 1, GY - top, T0)
	_rect(x + w - 1, top, 1, GY - top, T0)
	_rect(x + w - 4, top, 3, GY - top, W1)
	# Solar panels on the roof.
	for k in range(x + 20, x + w - 40, 34):
		for yy in 8:
			_rect(k + yy, top - 8 - yy, 30, 1, T1 if yy % 3 else T2)
	# Big windows + glass balconies on alternate bays.
	for f in range(1, floors):
		var fy := top + (f - 1) * fh
		for i in 4:
			var wx := x + 14 + i * (w - 28) / 4
			var ww := (w - 28) / 4 - 16
			_rect(wx - 1, fy + 8, ww + 2, 46, T0)
			var lit := _hash(wx, fy) < 0.18
			_rect(wx, fy + 9, ww, 44, O2 if lit else T1)
			_rect(wx, fy + 9, ww, 2, O3 if lit else T2)
			_rect(wx + ww / 2, fy + 9, 2, 44, R3)
			if not lit:
				for k in 12:
					_px(wx + 4 + k, fy + 48 - k * 3, T3)
			if (i + f) % 2 == 0:
				_rect(wx - 6, fy + 54, ww + 12, 4, R3)   # balcony slab
				_rect(wx - 6, fy + 54, ww + 12, 1, W5)
				for yy in range(fy + 36, fy + 54):
					for xx in range(wx - 6, wx + ww + 6):
						if _bayer(xx, yy) < 0.35:
							_px(xx, yy, T5)
				_rect(wx - 6, fy + 35, ww + 12, 1, R3)
				if _hash(i, f) < 0.5:
					_rect(wx + 4, fy + 42, 6, 12, B2)       # plant
					_leaves(wx + 7, fy + 38, 5)
	# Ground floor: lobby with mailboxes, bike garage door.
	var gy := GY - fh - 20
	_rect(x + 16, gy + 20, 110, fh, T0)
	_rect(x + 17, gy + 21, 108, fh - 1, T2)
	_rect(x + 60, gy + 21, 2, fh - 1, R3)
	for k in 4:
		_rect(x + 24 + k * 8, gy + 50, 6, 10, R3)
	for k in 14:
		_px(x + 80 + k, gy + 70 - k * 3, T4)
	_rect(x + 150, gy + 30, 100, GY - gy - 30, R1)
	for yy in range(gy + 32, GY, 4):
		_rect(x + 152, yy, 96, 1, R2)
	_rect(x + 176, gy + 18, 48, 10, T1)
	_text3(x + 182, gy + 20, "P", W5)
	_rect(x + 262, gy + 30, 50, GY - gy - 30, T0)
	_rect(x + 264, gy + 32, 46, GY - gy - 32, G1)
	_rect(x + 264, gy + 32, 1, GY - gy - 32, G2)
	_text3(x + 270, gy + 20, "102", T0)
	_seal(x, w)
	plot_l = -1000000
	plot_r = 1000000


