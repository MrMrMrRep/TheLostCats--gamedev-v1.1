func _viaduct() -> void:
	# Ring road (A10) on concrete pillars, its exit ramp sloping down into the street.
	var deck := GY - 180
	var ramp_end := 600
	# Shadow and pillars under the deck.
	for px_ in [30, 150, 270, 390]:
		_rect(px_, deck + 22, 30, GY - deck - 22, R2)
		_rect(px_, deck + 22, 6, GY - deck - 22, R3)
		_rect(px_ + 24, deck + 22, 6, GY - deck - 22, R1)
		_rect(px_ - 4, deck + 22, 38, 6, R1)
		_rect(px_ - 1, deck + 28, 32, 2, T1)
		_rect(px_, GY - 6, 30, 6, R1)
	for x in range(0, 460):
		for yy in range(deck + 22, deck + 40):
			if _bayer(x, yy) < 0.6 - (yy - deck - 22) * 0.035:
				var c := _get_px(x, yy)
				_px(x, yy, T1 if c != R3 and c != R2 else R1)
	# Graffiti on a pillar and a bike under the bridge.
	for g in [[156, B3], [158, O2], [276, T4]]:
		for k in 8:
			_rect(g[0] + k * 3, GY - 40 + int(sin(k * 1.3) * 4.0), 3, 3, g[1])
	# Deck: flat part + ramp.
	for x in range(0, ramp_end + 40):
		var y := deck
		if x > 420:
			y = deck + int((x - 420) * float(GY - 40 - deck) / float(ramp_end + 40 - 420))
		_rect(x, y, 1, 22, R2)
		_px(x, y, R3)
		_px(x, y + 1, W5)
		_rect(x, y + 18, 1, 4, R1)
		_px(x, y + 22, T0)
		# Concrete guard wall on top with a steel rail.
		_rect(x, y - 16, 1, 16, R3)
		_px(x, y - 16, W5)
		_px(x, y - 9, R2)
		if x % 30 == 0:
			_rect(x, y - 16, 1, 16, R2)
		_px(x, y - 20, R1)
		if x % 20 == 0:
			_rect(x, y - 20, 2, 4, R1)
	# The ramp's own slab down to street level.
	for x in range(420, ramp_end + 40):
		var y := deck + int((x - 420) * float(GY - 40 - deck) / float(ramp_end + 40 - 420))
		_rect(x, y + 22, 1, GY - y - 22, R2 if x % 40 > 2 else R1)
		_px(x, y + 22, T0)
	# Cars on the ring road (they come in from the polder).
	_vehicle(40, deck - 4, "wagon", "cream")
	_vehicle(230, deck - 4, "coupe", "red")
	# Blue direction sign on the deck.
	var sx := 330
	_rect(sx + 30, deck - 96, 4, 80, R2)
	_rect(sx + 110, deck - 96, 4, 80, R2)
	_rect(sx, deck - 150, 150, 58, T0)
	_rect(sx + 1, deck - 149, 148, 56, T2)
	_rect(sx + 4, deck - 146, 142, 50, W5)
	_rect(sx + 6, deck - 144, 138, 46, T2)
	_text5(sx + 14, deck - 136, "CENTRUM", W5)
	_text5(sx + 14, deck - 118, "RING", W5)
	_rect(sx + 50, deck - 120, 24, 11, B2)
	_text3(sx + 53, deck - 117, "A10", W5)
	_rect(sx + 128, deck - 136, 2, 26, W5)
	_triangle(sx + 123, deck - 136, 12, 7, W5)


func _grand_hotel(x: int, w: int) -> void:
	# 1900s grand hotel: cream stone, mansard, gilded name, canopy, flags.
	_scheme("cream")
	var floors := 5
	var top := GY - GF - ST * (floors - 1)
	_wall(x, top, w, GY - top)
	_gable(x, w, top, "mansard")
	_outline_lit(x, top, w)
	# Rusticated ground floor.
	for yy in range(GY - GF, GY - 8, 8):
		_rect(x + 2, yy, w - 4, 1, W3)
	# Floors: string course + window bays (balcony on the first floor).
	var bays := 6
	var bay := w / bays
	for f in range(1, floors):
		var fy := GY - GF - ST * f
		_course(x, fy + ST - 8, w)
		var wh := 30 if f == floors - 1 else 38
		for i in bays:
			var wx := x + i * bay + (bay - 22) / 2
			_window(wx, fy + 12, 22, wh, f == 1, f == 1)
		if f == 1:
			var bx := x + bay * 2 - 6
			var bw := bay * 2 + 12
			_rect(bx, fy + ST - 14, bw, 5, W3)
			_rect(bx, fy + ST - 14, bw, 1, W5)
			_rect(bx, fy + ST - 9, bw, 1, T0)
			for k in range(bx + 2, bx + bw - 2, 5):    # balustrade
				_rect(k, fy + ST - 26, 3, 12, W4)
				_px(k, fy + ST - 26, W5)
				_rect(k + 2, fy + ST - 24, 1, 10, W2)
			_rect(bx, fy + ST - 28, bw, 3, W3)
			_rect(bx, fy + ST - 28, bw, 1, W5)
	_cornice(x, top, w)
	# Gilded name over the ground floor.
	var sy := GY - GF - 4
	_rect(x + 40, sy - 18, w - 80, 16, T0)
	_rect(x + 41, sy - 17, w - 82, 14, G0)
	_rect(x + 41, sy - 17, w - 82, 1, G1)
	var name := _sign("GRAND HOTEL DE KAT")
	var tw := name.length() * 6 - 1
	_text5(x + w / 2 - tw / 2 + 1, sy - 13, name, T0)
	_text5(x + w / 2 - tw / 2, sy - 14, name, O2)
	_text5_top(x + w / 2 - tw / 2, sy - 14, name, O3)
	# Entrance: revolving door under a glass-and-iron canopy.
	var ex := x + w / 2 - 40
	_rect(ex - 1, GY - 72, 82, 72, T0)
	_rect(ex, GY - 71, 80, 71, T1)
	for k in range(ex + 4, ex + 80, 19):
		_rect(k, GY - 68, 15, 60, T2)
		_rect(k, GY - 68, 15, 2, T3)
		_rect(k + 1, GY - 50, 13, 1, O2)
		for i in 8:
			_px(k + 3 + i, GY - 20 - i * 3, T4)
	_rect(ex + 30, GY - 68, 20, 68, O1)                # warm lobby light through the door
	_rect(ex + 32, GY - 66, 16, 64, O2)
	_rect(ex + 39, GY - 66, 2, 64, T0)
	_rect(ex - 30, GY - 82, 140, 6, T0)                # canopy
	_rect(ex - 30, GY - 82, 140, 1, T2)
	for k in range(ex - 28, ex + 110, 10):
		_rect(k, GY - 88, 8, 6, T5)
		_px(k, GY - 88, T7)
	for k in [ex - 26, ex + 104]:                      # tie rods up to the wall
		_line(k, GY - 88, k + (12 if k < ex else -12), GY - 93, T0)
	for k in range(ex - 26, ex + 106, 22):
		_rect(k, GY - 76, 4, 3, W5)                    # bulbs
	# Side windows on the ground floor: tall arched, with lit rooms.
	for i in [0, 1, 4, 5]:
		var wx: int = x + i * bay + (bay - 26) / 2
		_window(wx, GY - GF + 22, 26, 50, false, true)
	# Steps and red carpet.
	for i in 3:
		_rect(ex - 6 - i * 4, GY - 4 + i * 2, 92 + i * 8, 2, R2 if i % 2 == 0 else R3)
	_rect(ex + 24, GY - 4, 32, 4, B1)
	_rect(ex + 24, GY - 4, 32, 1, B2)
	_topiary(ex - 16, GY)
	_topiary(ex + 96, GY)
	_plinth(x, w)
	_seal(x, w)


func _hotel_70s(x: int, w: int) -> void:
	# A 70s brick hotel with loggias and a vertical sign.
	_scheme("darkbrick")
	var top := GY - 380
	_wall(x, top, w, GY - top)
	_outline_lit(x, top, w)
	_rect(x, top - 8, w, 8, R3)
	_rect(x, top - 8, w, 1, W5)
	_rect(x, top - 1, w, 1, R1)
	var fh := 44
	for f in 7:
		var fy := top + 12 + f * fh
		_rect(x + 2, fy + fh - 6, w - 4, 4, R3)        # concrete floor band
		_rect(x + 2, fy + fh - 6, w - 4, 1, W5)
		_rect(x + 2, fy + fh - 2, w - 4, 1, B0)
		for wx in range(x + 14, x + w - 30, 42):
			_rect(wx - 1, fy + 3, 34, 30, T0)
			var lit := _hash(wx, fy) < 0.2
			_rect(wx, fy + 4, 32, 28, O2 if lit else T1)
			_rect(wx, fy + 4, 32, 2, O3 if lit else T2)
			_rect(wx + 15, fy + 4, 2, 28, R2)
			if not lit:
				for i in 9:
					_px(wx + 4 + i, fy + 28 - i * 2, T3)
			if _hash(wx, fy + 2) < 0.35:              # curtain
				_rect(wx + 1, fy + 4, 5, 28, [W4, B3, G2][int(_hash(fy, wx) * 3.0)])
			_rect(wx - 2, fy + 32, 36, 3, R2)            # concrete sill
			_rect(wx - 2, fy + 32, 36, 1, R3)
	# Vertical neon sign.
	var sx := x + w - 26
	_rect(sx, top + 30, 22, 120, T0)
	_rect(sx + 1, top + 31, 20, 118, B1)
	var word := "HOTEL"
	for i in word.length():
		_text5(sx + 8, top + 40 + i * 20, word[i], O3)
		_text5(sx + 7, top + 39 + i * 20, word[i], W5)
	_line(sx, top + 50, x + w - 2, top + 44, T0)
	# Ground floor: glass lobby + a concierge sign.
	_rect(x + 2, GY - 80, w - 4, 80, R3)
	_rect(x + 2, GY - 80, w - 4, 2, W5)
	_rect(x + 12, GY - 66, w - 24, 66, T0)
	_rect(x + 13, GY - 65, w - 26, 65, T2)
	for k in range(x + 13, x + w - 13, 28):
		_rect(k, GY - 65, 2, 65, R3)
	_rect(x + 60, GY - 50, 60, 40, O1)
	_rect(x + 60, GY - 50, 60, 3, O2)
	_rect(x + 70, GY - 30, 40, 14, W1)
	for k in 16:
		_px(x + 140 + k, GY - 10 - k * 3, T4)
	_rect(x + 2, GY - 92, w - 4, 12, T1)
	_text5(x + 20, GY - 89, _sign("HOTEL ZUID"), W5)
	_plinth(x, w)
	_seal(x, w)


