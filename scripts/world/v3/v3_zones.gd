func _church(x: int, w: int) -> void:
	# The Oude Kerk-like church: tower with clock and spire, brick nave with
	# buttresses and tall traceried windows, a slate roof.
	var tw := 100
	var nx := x + tw
	var nw := w - tw
	var wall_top := GY - 220
	# Nave roof (slate), drawn first so the tower overlaps it.
	var rh := 120
	for yy in rh:
		var inset := yy * nw / (rh * 2) / 3
		for xx in range(nx + inset - 6, nx + nw - inset + 6):
			var row := yy / 5
			var j := (xx + (row % 2) * 4) % 8
			var c := R1
			if yy % 5 == 4 or j == 0:
				c = R0
			elif yy % 5 == 0:
				c = R2 if _hash(xx / 8, row) < 0.5 else R1
			if xx > nx + nw - inset - 10:
				c = R0 if c == R1 else c
			_px(xx, wall_top - yy, c)
	_rect(nx + nw / 3 - 6, wall_top - rh - 2, nw / 3 + 12, 3, T0)
	# Ridge turret (dakruiter).
	var rx := nx + nw / 2
	_rect(rx - 8, wall_top - rh - 40, 16, 40, W0)
	_rect(rx - 8, wall_top - rh - 40, 3, 40, W1)
	_rect(rx - 4, wall_top - rh - 34, 8, 14, T0)
	_triangle(rx - 10, wall_top - rh - 40, 20, 26, R1)
	_rect(rx, wall_top - rh - 74, 1, 10, T0)
	# Nave walls: dark brick with buttresses and lancet windows.
	_scheme("darkbrick")
	_wall(nx, wall_top, nw, GY - wall_top)
	_rect(nx, wall_top - 4, nw, 4, W3)
	_rect(nx, wall_top - 4, nw, 1, W5)
	_rect(nx, wall_top, nw, 1, T0)
	_rect(nx + nw - 1, wall_top, 1, GY - wall_top, T0)
	var bays := 4
	var bay := nw / bays
	for i in bays:
		var bx := nx + i * bay
		# Buttress.
		_rect(bx, wall_top + 10, 14, GY - wall_top - 10, B0)
		_rect(bx, wall_top + 10, 3, GY - wall_top - 10, B2)
		for k in [wall_top + 60, wall_top + 130]:
			_rect(bx - 2, k, 18, 4, W3)
			_rect(bx - 2, k, 18, 1, W5)
		_triangle(bx - 1, wall_top + 12, 16, 12, W3)
		# Lancet window with tracery.
		var wx := bx + 26
		var ww := bay - 40
		var wtop := wall_top + 30
		var wbot := GY - 50
		for yy in range(wtop - ww / 2 - 4, wbot + 4):
			for xx in range(wx - 4, wx + ww + 4):
				var inside := yy >= wtop or _in_arch(xx - wx, yy - wtop, ww, 4)
				if inside:
					_px(xx, yy, W3)
		for yy in range(wtop - ww / 2, wbot):
			for xx in range(wx, wx + ww):
				if yy >= wtop or _in_arch(xx - wx, yy - wtop, ww, 0):
					var c := T1
					if (xx + yy / 2) % 7 == 0:
						c = T2
					if ((yy - wtop) % 14 == 0) or ((xx - wx) % (ww / 3) == 0):
						c = W2
					if _hash(xx / 4, yy / 6) < 0.03 and c == T1:
						c = T3
					_px(xx, yy, c)
		WDisc.ring(self, wx + ww / 2, wtop - ww / 4, ww / 5, W2)
		_rect(wx - 4, wbot, ww + 8, 3, W3)
		_rect(wx - 4, wbot, ww + 8, 1, W5)
		_rect(wx - 4, wbot + 3, ww + 8, 1, T0)
	# Tower: brick shaft, stone stages, clock, open lantern, spire.
	_scheme("brick")
	var tt := GY - 330
	_wall(x, tt, tw, GY - tt)
	_outline_lit(x, tt, tw)
	for k in [GY - 120, GY - 240]:
		_course(x, k, tw)
	# Tower door (pointed arch).
	var dx := x + tw / 2 - 18
	for yy in range(GY - 90, GY):
		for xx in range(dx - 4, dx + 40):
			if yy >= GY - 70 or _in_arch(xx - dx, yy - (GY - 70), 36, 4):
				_px(xx, yy, W3)
	for yy in range(GY - 86, GY):
		for xx in range(dx, dx + 36):
			if yy >= GY - 70 or _in_arch(xx - dx, yy - (GY - 70), 36, 0):
				_px(xx, yy, W0 if (xx - dx) % 6 else T0)
	_rect(dx + 17, GY - 86, 2, 86, T0)
	_rect(dx + 12, GY - 40, 3, 3, O2)
	_rect(dx + 21, GY - 40, 3, 3, O2)
	# Belfry louvres.
	for lx in [x + 18, x + 58]:
		_rect(lx, GY - 228, 24, 70, T0)
		for yy in range(GY - 224, GY - 162, 6):
			_rect(lx + 2, yy, 20, 3, W1)
			_rect(lx + 2, yy, 20, 1, W2)
	# Stone stage with the clock.
	var st := GY - 396
	_rect(x + 6, st, tw - 12, 92, W3)
	_rect(x + 6, st, 3, 92, W5)
	_rect(x + tw - 10, st, 4, 92, W2)
	_rect(x + 6, st, 1, 92, T0)
	_rect(x + tw - 7, st, 1, 92, T0)
	_rect(x, st + 88, tw, 4, W4)
	_rect(x, st + 88, tw, 1, W5)
	var cx := x + tw / 2
	var cy := st + 44
	WDisc.draw(self, cx, cy, 26, T0)
	WDisc.draw(self, cx, cy, 24, O2)
	WDisc.draw(self, cx, cy, 21, T1)
	for h in 12:
		var a := deg_to_rad(h * 30.0)
		_rect(cx + int(cos(a) * 18.0) - 1, cy + int(sin(a) * 18.0) - 1, 2, 2, O3)
	_line(cx, cy, cx + 10, cy - 6, O3)
	_line(cx, cy, cx - 2, cy - 15, O3)
	_px(cx, cy, W5)
	for k in [x + 4, x + tw - 8]:                       # corner pinnacles
		_rect(k, st - 24, 4, 24, W3)
		_triangle(k - 1, st - 24, 6, 10, R1)
	_rect(x + 2, st - 4, tw - 4, 4, W4)
	_rect(x + 2, st - 4, tw - 4, 1, W5)
	# Octagonal open lantern + spire.
	var lt := st - 52
	_rect(x + 18, lt, tw - 36, 48, T0)
	for k in range(x + 20, x + tw - 20, 10):
		_rect(k, lt, 4, 48, W0)
		_rect(k, lt, 1, 48, W1)
	WDisc.draw(self, cx, lt + 32, 6, O2)                 # the bell
	_rect(cx - 7, lt + 36, 14, 3, O1)
	_rect(x + 14, lt - 4, tw - 28, 4, W3)
	_rect(x + 14, lt - 4, tw - 28, 1, W5)
	var sh := 84
	for yy in sh:
		var half := int((tw / 2 - 16) * (1.0 - float(yy) / sh)) + 1
		for xx in range(-half, half):
			var c := R1
			if xx < -half / 2:
				c = R2
			elif xx > half / 3:
				c = R0
			if (lt - 4 - yy) % 6 == 0:
				c = R0 if c != R0 else T1
			_px(cx + xx, lt - 4 - yy, c)
		_px(cx - half - 1, lt - 4 - yy, T0)
		_px(cx + half, lt - 4 - yy, T0)
	_rect(cx, lt - sh - 22, 1, 20, T0)
	_rect(cx - 4, lt - sh - 14, 9, 1, T0)
	WDisc.draw(self, cx, lt - sh - 24, 2, O2)            # golden weathercock-ish
	_px(cx + 2, lt - sh - 26, O3)


func _in_arch(dx: int, dy: int, w: int, grow: int) -> bool:
	# Is (dx, dy) inside a pointed (gothic) arch of width w springing at dy = 0?
	if dy >= 0:
		return dx >= -grow and dx < w + grow
	var r := float(w + grow * 2)
	var y := float(-dy)
	var left := Vector2(float(w + grow) - r, 0.0)
	var right := Vector2(r - float(grow), 0.0)
	var p := Vector2(float(dx), 0.0)
	return (p - left).length_squared() + y * y <= r * r and (p - right).length_squared() + y * y <= r * r and dx >= -grow and dx < w + grow


func _market_stall(x: int, w: int, cols: Array, kind: String) -> void:
	var b := GY + 8
	# Poles, striped roof, table with crates.
	for px_ in [x + 2, x + w - 4]:
		_rect(px_, b - 92, 3, 92, R1)
		_px(px_, b - 92, R2)
	_awning(x - 4, b - 100, w + 8, cols)
	_rect(x, b - 34, w, 4, W1)
	_rect(x, b - 34, w, 1, W2)
	_rect(x, b - 30, w, 30, W0)
	for k in range(x + 4, x + w - 4, 10):
		_rect(k, b - 30, 1, 30, W1)
	for cxx in range(x + 4, x + w - 24, 24):
		_rect(cxx, b - 44, 22, 10, W1)                  # crate
		_rect(cxx, b - 44, 22, 1, W2)
		_rect(cxx, b - 39, 22, 1, W0)
		for i in 9:
			var fx := cxx + 1 + int(_hash(cxx + i, 1) * 18.0)
			var fy := b - 49 + int(_hash(1, cxx + i) * 5.0)
			var fc: Color
			if kind == "kaas":
				fc = [O2, O2, B2][int(_hash(cxx, i) * 3.0)]
				_rect(fx, fy, 5, 4, fc)
				_px(fx, fy, O3 if fc == O2 else B3)
			else:
				fc = [B2, O1, G3, G2, O2][((cxx - x) / 24) % 5]
				WDisc.draw(self, fx + 2, fy + 2, 2, fc)
				_px(fx + 1, fy + 1, W5 if fc != G3 else G4)
		_rect(cxx + 6, b - 58, 10, 7, W5)               # price card
		_text3(cxx + 7, b - 57, ["2", "3", "1", "4"][((cxx - x) / 24) % 4], T0)
	# Scale on the corner.
	_rect(x + w - 20, b - 52, 14, 8, R3)
	_rect(x + w - 20, b - 52, 14, 1, W5)
	_rect(x + w - 15, b - 60, 4, 8, R2)


