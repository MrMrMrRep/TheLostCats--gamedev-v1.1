func _is_glass(x: int, y: int) -> bool:
	if not _inside(x, y):
		return false
	return super(x, y)


func _scheme(name: String) -> void:
	var s: Array = SCHEMES[name]
	cb = s[0]
	cs = s[1]
	ch = s[2]
	ct = s[3]
	cts = s[4]
	cd = s[5]
	is_brick = s[6]


func _outline_lit(x: int, top: int, w: int) -> void:
	# Light from the top-left: highlight left, shade right, dark outline.
	_rect(x + 1, top, 2, GY - top, ch)
	_rect(x + w - 4, top, 3, GY - top, cs)
	_rect(x, top, 1, GY - top, T0)
	_rect(x + w - 1, top, 1, GY - top, T0)


func _course(x: int, y: int, w: int) -> void:
	# A stone string course. It stops on the party wall, same as the roof edge.
	_rect(x, y, w, 1, T0)
	_rect(x, y + 1, w, 1, W5 if ct != T1 else T2)
	_rect(x, y + 2, w, 3, ct)
	_rect(x, y + 5, w, 1, cts)
	_rect(x, y + 6, w, 2, cs)


func _cornice(x: int, top: int, w: int) -> void:
	# The same flat roof edge on every block: stone lip, dentils, shadow under.
	# Nothing sticks into the next sprite.
	_rect(x, top - 8, w, 1, T0)
	_rect(x, top - 7, w, 1, W5 if ct != T1 else T2)
	_rect(x + 1, top - 6, w - 2, 4, ct)
	_rect(x, top - 2, w, 1, cts)
	_rect(x, top - 1, w, 1, T0)
	for bx in range(x + 4, x + w - 8, 14):
		_bevel(bx, top - 1, 4, 6, ct, W5, cts)
	_rect(x + 1, top + 1, w - 2, 2, cs)


const PARKED := [["hatch", "coral"], ["wagon", "teal"], ["sedan", "cream"], ["mpv", "silver"],
	["duck", "green"], ["coupe", "red"], ["sedan", "navy"], ["hatch", "yellow"], ["wagon", "brown"],
	["mpv", "plum"], ["hatch", "white"], ["sedan", "black"]]


func _parked(x: int, kind: int) -> void:
	var v: Array = PARKED[kind % PARKED.size()]
	_vehicle(x, WATER - 9, v[0], v[1])


func _taxi(x: int) -> void:
	_vehicle(x, WATER - 9, "taxi", "yellow")


func _bench(x: int) -> void:
	var b := GY + 8
	_rect(x, b - 14, 40, 3, W1)
	_rect(x, b - 14, 40, 1, W2)
	_rect(x, b - 22, 40, 3, W1)
	_rect(x, b - 22, 40, 1, W2)
	_rect(x, b - 27, 40, 3, W1)
	_rect(x, b - 27, 40, 1, W2)
	for lx in [x + 3, x + 34]:
		_rect(lx, b - 28, 3, 28, T0)
		_rect(lx - 2, b - 2, 7, 2, T0)
	_rect(x + 3, b - 11, 34, 1, T0)


func _hedge(x: int, w: int, top: int) -> void:
	_rect(x, top + 6, w, GY - top - 6, G0)
	for hx in range(x + 4, x + w - 3, 7):
		_leaves(hx, top + 6 + int(_hash(hx, 1) * 3.0), 6)
	for hx in range(x + 2, x + w - 3, 9):
		_leaves(hx, top + 16, 6)
	_rect(x, GY - 3, w, 3, G0)


func _poster(x: int, y: int, w: int, h: int, k: int) -> void:
	# A gig poster: bold colour field, a shape, a band name strip.
	var bg: Color = [B2, O2, T3, P0, G2, O1][k % 6]
	var fg: Color = [O3, B1, W5, O2, W5, T1][k % 6]
	_rect(x - 1, y - 1, w + 2, h + 2, T0)
	_rect(x, y, w, h, bg)
	WDisc.draw(self, x + w / 2, y + h / 3, mini(w, h) / 4, fg)
	_rect(x + 2, y + h - 8, w - 4, 2, fg)
	_rect(x + 2, y + h - 5, w - 7, 1, W5)
	_px(x + 1, y + 1, W5)


func _poster_column(x: int) -> void:
	# Amsterdam advertising column (reclamezuil): green, posters, a dome.
	var b := GY + 8
	_rect(x - 18, b - 6, 36, 6, G0)
	_rect(x - 16, b - 112, 32, 106, G0)
	_rect(x - 16, b - 112, 6, 106, G1)
	for i in 3:
		_poster(x - 13 + i * 10 - (i / 2), b - 100, 9, 40, i + 1)
		_poster(x - 13 + i * 10 - (i / 2), b - 54, 9, 40, i + 3)
	_rect(x - 19, b - 118, 38, 6, G0)
	_rect(x - 19, b - 118, 38, 1, G2)
	for yy in 14:
		var half := int(16.0 * sqrt(maxf(1.0 - pow(yy / 14.0, 2.0), 0.0)))
		_rect(x - half, b - 119 - yy, half * 2, 1, G1 if yy % 4 else G0)
		_px(x - half, b - 119 - yy, G2)
	WDisc.draw(self, x, b - 136, 3, O2)


func _plant_box(x: int) -> void:
	var b := GY + 8
	_rect(x, b - 14, 30, 14, W1)
	_rect(x, b - 14, 30, 2, W2)
	for k in range(x + 2, x + 30, 7):
		_rect(k, b - 12, 1, 12, W0)
	for i in 5:
		_leaves(x + 4 + i * 6, b - 18 - int(_hash(x, i) * 4.0), 5)
	for i in 7:
		_rect(x + 2 + int(_hash(i, x) * 26.0), b - 24 + int(_hash(x, i + 9) * 8.0), 2, 2, [B3, O2, W5][i % 3])


