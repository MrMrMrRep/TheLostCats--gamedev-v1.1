	_rect(x, base - 20, 34, 1, W5 if not brown else W2)
	_rect(x + 4, base - 18, 9, 7, spot)
	_rect(x + 18, base - 20, 8, 5, spot)
	_rect(x + 22, base - 12, 6, 4, spot)
	_rect(x + 33, base - 22, 10, 9, body)           # head
	_rect(x + 40, base - 17, 4, 4, B4)
	_px(x + 37, base - 20, T0)
	_rect(x + 34, base - 24, 2, 2, W3)
	for lx in [x + 2, x + 8, x + 24, x + 30]:
		_rect(lx, base - 6, 3, 6, body)
		_rect(lx, base - 1, 3, 1, T0)
