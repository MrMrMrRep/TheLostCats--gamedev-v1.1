func _farm(x: int, b: int) -> void:
	# Dutch farm: brick front house, long barn under a big tiled roof.
	var bw := 220
	for yy in range(b - 54, b):
		for xx in range(x, x + bw):
			var c := B2 if ((xx + (yy / 3 % 2) * 4) % 8 != 0 and yy % 3 != 2) else B1
			_px(xx, yy, c)
	_rect(x + bw - 4, b - 54, 4, 54, B1)
	_rect(x, b - 54, 2, 54, B3)
	# Roof: tiles in rows, shaded on the right, ridge.
	var rh := 64
	for yy in rh:
		var inset := yy * 2 / 3
		var l := x - 10 + inset
		var r := x + bw + 10 - inset
		for xx in range(l, r):
			var row := yy / 4
			var j := (xx + (row % 2) * 3) % 6
			var c := B1
			if yy % 4 == 3 or j == 0:
				c = B0
			elif yy % 4 == 0:
				c = B2
			if xx > r - 12:
				c = B0 if c == B1 else c
			_px(xx, b - 54 - yy, c)
	_rect(x - 10, b - 55, bw + 20, 2, T0)
	_rect(x + 20, b - 54 - rh, bw - 40, 2, T1)
	_chimney(x + 40, b - 54 - rh + 4)
	# Barn doors: green with white diamond, the Dutch way.
	for dx in [x + 120, x + 160]:
		_rect(dx - 1, b - 46, 34, 46, T0)
		_rect(dx, b - 45, 32, 45, G1)
		for k in range(dx + 2, dx + 32, 4):
			_rect(k, b - 45, 1, 45, G0)
		for yy in 22:
			var half := 16 - absi(yy - 11) * 16 / 11
			_px(dx + 16 - half, b - 34 + yy, W5)
			_px(dx + 15 + half, b - 34 + yy, W5)
	# House front: white windows with green shutters.
	for wx in [x + 14, x + 54, x + 90]:
		_rect(wx - 1, b - 40, 20, 24, T0)
		_rect(wx, b - 39, 18, 22, W5)
		_rect(wx + 2, b - 37, 14, 18, T0)
		_rect(wx + 2, b - 37, 14, 2, T1)
		_rect(wx + 8, b - 39, 2, 22, W5)
		_rect(wx + 2, b - 29, 14, 1, W5)
		_px(wx + 3, b - 36, T3)
		for sx in [wx - 7, wx + 19]:
			_rect(sx, b - 40, 6, 24, G1)
			_rect(sx, b - 40, 6, 1, G2)
			_rect(sx + 1, b - 34, 4, 1, G0)
			_rect(sx + 1, b - 26, 4, 1, G0)
	# Hay bales, a milk can.
	for hx in [x + 230, x + 252]:
		WDisc.draw(self, hx, b - 9, 9, W3)
		WDisc.ring(self, hx, b - 9, 6, W2)
		WDisc.ring(self, hx, b - 9, 3, W2)
	_rect(x + 270, b - 12, 6, 12, R3)
	_rect(x + 271, b - 15, 4, 3, R2)


func _windmill(x: int, b: int) -> void:
	# Smock mill: brick base, thatched octagonal body, stage, cap, lattice sails.
	for yy in range(b - 34, b):
		for xx in range(x - 34, x + 34):
			var c := B1 if ((xx + (yy / 3 % 2) * 4) % 8 != 0 and yy % 3 != 2) else B0
			_px(xx, yy, c)
	_rect(x - 34, b - 34, 2, 34, B2)
	_rect(x - 8, b - 26, 16, 26, T0)
	_rect(x - 7, b - 25, 14, 25, G1)
	_rect(x - 7, b - 25, 14, 1, G2)
	var bh := 150
	for yy in bh:
		var half := 30 - yy * 14 / bh
		for xx in range(-half, half):
			var t := float(xx + half) / (half * 2)
			var c := R1
			if t < 0.25:
				c = R2
			elif t > 0.75:
				c = R0
			if (x + xx) % 3 == 0 and _hash(x + xx, (b - 34 - yy) / 3) < 0.6:
				c = R0 if c != R0 else T1
			_px(x + xx, b - 34 - yy, c)
		_px(x - half - 1, b - 34 - yy, T0)
		_px(x + half, b - 34 - yy, T0)
	for wy in [b - 90, b - 140]:                    # small windows
		_rect(x - 4, wy, 8, 10, W5)
		_rect(x - 3, wy + 1, 6, 8, T0)
	# Stage (gallery) with railing.
	var sy := b - 70
	_rect(x - 50, sy, 100, 4, W0)
	_rect(x - 50, sy, 100, 1, W1)
	_rect(x - 50, sy - 12, 100, 2, W0)
	for k in range(x - 50, x + 51, 6):
		_rect(k, sy - 12, 1, 12, W0)
	for k in range(x - 46, x + 47, 14):
		_line(k, sy + 4, x + (k - x) / 3, b - 34, W0)
	# Cap.
	var cy := b - 34 - bh
	for yy in 18:
		var half := 20 - yy / 2
		_rect(x - half, cy - yy, half * 2, 1, W1 if yy % 3 else W0)
		_px(x - half, cy - yy, W2)
	_rect(x - 20, cy, 40, 2, T0)
	var hub := Vector2(x, cy - 10)
	# Tail pole down to the ground.
	_line(x + 4, cy - 4, x + 70, b - 2, W0)
	_line(x + 5, cy - 4, x + 71, b - 2, W0)
	WDisc.ring(self, x + 70, b - 8, 6, W0)
	# Four lattice sails, two with cloth.
	for s in 4:
		var a := deg_to_rad(28.0 + s * 90.0)
		var d := Vector2(cos(a), sin(a))
		var n := Vector2(-d.y, d.x)
		for k in range(6, 128):
			var p := hub + d * k
			_rect(int(p.x) - 1, int(p.y) - 1, 2, 2, W0)
			if k > 22:
				var e := p + n * 16
				_px(int(e.x), int(e.y), W3)
				if k % 7 == 0:
					for j in range(1, 16):
						var q := p + n * j
						_px(int(q.x), int(q.y), W3)
				if s % 2 == 0:
					for j in range(2, 15):
						var q := p + n * j
						if k % 7 != 0:
							_px(int(q.x), int(q.y), W4 if j < 11 else W3)
	WDisc.draw(self, int(hub.x), int(hub.y), 5, W0)
	_px(int(hub.x) - 1, int(hub.y) - 2, W2)


