{
  "pack": "amwoods",
  "author": "brullov (itch.io)",
  "license_note": "Purchased asset pack, see readme.TXT. Stand-in art for v1.",
  "root": "res://public/assets/amwoods/",
  "pixel_scale_notes": "Native art grid. Use nearest filtering. Backgrounds are 320x180 (half of the 640x360 viewport).",
  "conventions": {
    "coords": "Pixel rects are [x, y, w, h]. Tile coords are [col, row] in tile units.",
    "origin": "Character frames are bottom-aligned: feet touch the bottom edge of each 56x56 cell."
  },

  "backgrounds": [
    {
      "id": "bg_far",
      "path": "background/background_layer_1.png",
      "size": [320, 180],
      "depth": "farthest (misty blue forest)",
      "parallax_scroll_scale": [0.2, 1.0],
      "repeat_x": true
    },
    {
      "id": "bg_mid",
      "path": "background/background_layer_2.png",
      "size": [320, 180],
      "depth": "middle",
      "parallax_scroll_scale": [0.5, 1.0],
      "repeat_x": true
    },
    {
      "id": "bg_near",
      "path": "background/background_layer_3.png",
      "size": [320, 180],
      "depth": "nearest (big autumn trees, transparent gaps)",
      "parallax_scroll_scale": [0.8, 1.0],
      "repeat_x": true
    }
  ],

  "spritesheets": [
    {
      "id": "char_blue",
      "path": "character/char_blue.png",
      "size": [448, 392],
      "frame_size": [56, 56],
      "columns": 8,
      "rows": 7,
      "body_bounds_in_frame": [18, 24, 22, 32],
      "suggested_offset": [0, -28],
