      { "id": "dirt_column_2x3",    "origin": [19, 0], "size": [2, 3],  "kind": "background", "note": "Back-wall column." },
      { "id": "grass_cross",        "tiles": [[6,2],[5,3],[7,3],[6,4],[6,5]], "kind": "solid", "note": "Grass ends: top cap, left/right caps, vertical column pieces." },
      { "id": "stone_cross",        "tiles": [[10,2],[9,3],[11,3],[10,4]],      "kind": "solid", "note": "Stone ends: top, left, right, bottom caps." },
      { "id": "stone_roof",         "origin": [0, 5],  "size": [4, 2],  "kind": "slope",      "note": "Stone roof / 45-degree slope. Collision polygons TODO (M5)." },
      { "id": "grass_roof",         "origin": [0, 7],  "size": [4, 2],  "kind": "slope",      "note": "Grass roof / 45-degree slope. Collision polygons TODO (M5)." },
      { "id": "stone_platform_3",   "origin": [5, 7],  "size": [3, 1],  "kind": "one_way" },
      { "id": "grass_platform_3",   "origin": [5, 9],  "size": [3, 1],  "kind": "one_way" },
      { "id": "dark_platform_3",    "origin": [5, 11], "size": [3, 1],  "kind": "one_way" },
      { "id": "stone_pillar",       "origin": [9, 6],  "size": [2, 5],  "kind": "solid",      "note": "Tall pillar/wall with ember spots." },
      { "id": "grass_platform_2a",  "origin": [12, 6], "size": [2, 1],  "kind": "one_way" },
      { "id": "grass_platform_2b",  "origin": [12, 8], "size": [2, 1],  "kind": "one_way" },
      { "id": "stone_platform_2",   "origin": [12, 10],"size": [2, 1],  "kind": "one_way" },
      { "id": "dirt_bits",          "tiles": [[15,5],[15,6],[15,8],[16,8],[15,10],[15,11]], "kind": "background" },
      { "id": "dirt_wall_big",      "origin": [16, 5], "size": [5, 10], "kind": "background", "note": "Large back-wall; irregular shape, only filled cells become tiles." },
      { "id": "ground_fill_steps",  "origin": [0, 10], "size": [4, 5],  "kind": "solid",      "note": "Dark underground fill, stepped outline." },
      { "id": "underground_fill",   "origin": [5, 13], "size": [10, 2], "kind": "solid",      "note": "Dark fill with ember spots, for below the ground surface. Row 13 has cols 5-14; row 14 only cols 5-12 ([13,14],[14,14] are empty)." }
